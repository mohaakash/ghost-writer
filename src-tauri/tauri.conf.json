{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost Writer",
  "version": "0.1.0",
  "identifier": "com.akash.ghostwriter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ghost Writer",
        "width": 340,
        "height": 470,
        "resizable": false,
        "minWidth": 340,
        "minHeight": 100,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true,
        "visible": true
      },
      {
        "label": "notepad",
        "title": "Ghost Writer Notepad",
        "url": "notepad.html",
        "width": 580,
        "height": 660,
        "minWidth": 360,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true,
        "visible": false
      },
      {
        "label": "clipboard",
        "title": "Ghost Writer Clipboard",
        "url": "clipboard.html",
        "width": 420,
        "height": 600,
        "minWidth": 340,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
